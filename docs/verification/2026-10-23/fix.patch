--- a/tests/test_document_processing_runner.py
+++ b/tests/test_document_processing_runner.py
@@ -11,6 +11,7 @@ import subprocess
 import sys
 import tempfile
 import unittest
+from unittest.mock import patch
 from pathlib import Path
 
 REPO_ROOT = Path(__file__).resolve().parents[1]
@@ -124,6 +125,20 @@ class DocumentProcessingRunnerTests(unittest.TestCase):
                             path.write_bytes(b"not a real document")
                             runner.extract_document(path, extractor)
 
+    def test_explicit_parser_failures_use_extraction_error(self) -> None:
+        for extractor, function in (
+            ("docling", "extract_docling"),
+            ("markitdown", "extract_markitdown"),
+            ("python-docx", "extract_python_docx"),
+            ("pypdf", "extract_pypdf"),
+        ):
+            with self.subTest(extractor=extractor), tempfile.TemporaryDirectory() as td:
+                path = Path(td) / "corrupt.pdf"
+                path.write_bytes(b"corrupt")
+                with patch.object(runner, function, side_effect=RuntimeError("invalid document")):
+                    with self.assertRaisesRegex(runner.ExtractionError, "invalid document"):
+                        runner.extract_document(path, extractor)
+
     def test_auto_sector_clinical_procurement_general(self) -> None:
         self.assertEqual(runner.auto_sector("clinical patient clinician safety incident"), "clinical_ai")
         self.assertEqual(runner.auto_sector("procurement vendor contract audit access"), "procurement_vendor_governance")
diff --git a/tests/test_evidence_checks.py b/tests/test_evidence_checks.py
index ed3c5a6..d34df6e 100644
--- a/tests/test_evidence_checks.py
+++ b/tests/test_evidence_checks.py
@@ -83,6 +83,38 @@ class EvidenceChecksTests(unittest.TestCase):
         self.control["evidence"][0]["quote"] = "invented successful result"
         self.assertEqual(self.status(), "EVIDENCE_INVALID")
 
+    def test_missing_or_malformed_evidence_quotes_never_count(self):
+        for quote in (None, "", "   ", [], {}, 7):
+            with self.subTest(quote=quote):
+                self.control["evidence"] = self._example_evidence()
+                self.control["evidence"][0]["quote"] = quote
+                self.assertEqual(self.status(), "EVIDENCE_INVALID")
+        self.control["evidence"] = self._example_evidence()
+        del self.control["evidence"][1]["quote"]
+        self.assertEqual(self.status(), "EVIDENCE_INVALID")
+
+    def test_malformed_test_metadata_is_diagnosed_without_crashing(self):
+        for field in ("type", "outcome", "test_id"):
+            for value in (None, [], {}, 7, ""):
+                with self.subTest(field=field, value=value):
+                    self.control["evidence"] = self._example_evidence()
+                    self.control["evidence"][0][field] = value
+                    self.assertEqual(self.status(), "EVIDENCE_INVALID")
+
+    def test_cli_strict_gate_rejects_missing_quote_and_malformed_metadata(self):
+        for field in ("quote", "type", "outcome"):
+            with self.subTest(field=field):
+                self.control["evidence"] = self._example_evidence()
+                self.control["evidence"][0][field] = None if field == "quote" else []
+                path = self.root / "manifest.json"
+                path.write_text(json.dumps(self.manifest), encoding="utf-8")
+                result = subprocess.run(
+                    [sys.executable, str(CHECKER), str(path), "--require-review-ready"],
+                    text=True, capture_output=True)
+                self.assertEqual(result.returncode, 1)
+                self.assertIn('"status": "EVIDENCE_INVALID"', result.stdout)
+                self.assertNotIn("Traceback", result.stderr)
+
     def test_outside_path_and_symlink_not_accepted(self):
         self.control["evidence"][0]["file"] = "../out-of-scope.txt"
         self.assertEqual(self.status(), "EVIDENCE_INVALID")
